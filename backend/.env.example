# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/aarogya_pravah_ai

# Security & Authentication
JWT_SECRET=super_secret_aarogya_pravah_jwt_key_hackathon_2026_change_in_production
JWT_EXPIRES_IN=7d

# Groq AI Clinical Triage Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Client Frontend CORS Configuration
CLIENT_URL=http://localhost:5173

# Queue Configuration
AVG_CONSULTATION_MINUTES=15
MAX_QUEUE_CAPACITY=100
AGING_BOOST_MINUTES=10
AGING_BOOST_POINTS=2
PENDING_RETURN_PRIORITY_BOOST=35

# Cloudinary Medical Image Storage Configuration (Server-Side Only)
# Option 1: Direct connection string
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Option 2: Individual credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_FOLDER=aarogya-pravah-ai/xrays

# FastAPI TensorFlow/Keras Chest X-Ray Screening ML Service Configuration
MODEL_SERVICE_URL=http://localhost:8001
MODEL_SERVICE_TIMEOUT=15000
