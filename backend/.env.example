# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/smart_queue_ai

# Security & Authentication
JWT_SECRET=super_secret_smart_queue_jwt_key_hackathon_2026_change_in_production
JWT_EXPIRES_IN=7d

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Client Frontend CORS Configuration
CLIENT_URL=http://localhost:5173

# Queue Configuration
AVG_CONSULTATION_MINUTES=15
MAX_QUEUE_CAPACITY=100
AGING_BOOST_MINUTES=10
AGING_BOOST_POINTS=2
PENDING_RETURN_PRIORITY_BOOST=35
