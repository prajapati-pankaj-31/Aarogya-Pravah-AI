# Hugging Face Model Repository Configuration
# Example: username/dataset-name or username/model-name
HF_REPO_ID=your_hf_username/chest-xray-dataset
HF_MODEL_FILENAME=densenet_chest_xray.h5

# Repository type: 'dataset' (if model is stored in HF Datasets) or 'model' (if stored in HF Models)
HF_REPO_TYPE=dataset

# Optional Hugging Face Access Token (Required only if the repository is private)
# Get your token from: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_personal_access_token_here

# Service Server Configuration
HOST=0.0.0.0
PORT=8001
