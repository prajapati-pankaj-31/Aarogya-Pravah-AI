# ==============================================================================
# Aarogya Pravah AI — Frontend Environment Variables (Vite / Vercel)
# Note: All VITE_* variables are embedded into the client build and are public.
# DO NOT put secrets, private keys, or credentials in this file.
# ==============================================================================

# Backend REST API Endpoint (Include /api suffix)
# For local dev: http://localhost:5000/api
# For production: https://your-backend-service.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Backend Real-Time Socket.IO Server Endpoint (Do NOT include /api suffix)
# For local dev: http://localhost:5000
# For production: https://your-backend-service.onrender.com
VITE_SOCKET_URL=http://localhost:5000

